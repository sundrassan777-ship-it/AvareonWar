{
  "mission_1_intro": {
    "slides": [
      {
        "image": "../../Downloads/M1C1I1.png",
        "camera_a": {
          "x": 31.95187969924808,
          "y": 117.27857142857152,
          "width": 1032.6601503759398,
          "height": 580.8713345864662,
          "rotation": 0
        },
        "camera_b": {
          "x": 452.3308270676689,
