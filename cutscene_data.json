          "width": 1074.4075187969925,
          "height": 604.3542293233083,
          "rotation": 0
        },
        "pan_duration": 10.0,
        "crossfade_duration": 1.0,
        "easing": "linear",
        "audio": "../../Downloads/M1C1I1V.mp3",
        "audio_volume": 1.0,
        "audio_start_delay": 0.0,
        "music": "",
        "music_volume": 0.4,
        "music_start_delay": 0.0,
        "subtitle": "The valleys near the western Euve river have provided a good life for the local tribes for centuries."
      },
      {
        "image": "../../Downloads/M1C1I2.png",
        "camera_a": {
          "x": 310.66466165413533,
          "y": 17.40300751879701,
          "width": 961.990977443609,
          "height": 541.1199248120301,
          "rotation": 0
        },
        "camera_b": {
          "x": 11.749835706234308,
          "y": 131.03613920167345,
          "width": 1505.1667797449195,
          "height": 846.6563136065173,
          "rotation": 0
        },
        "pan_duration": 12.0,
        "crossfade_duration": 1.0,
        "easing": "linear",
        "audio": "../../Downloads/M1C1I2V.mp3",
        "audio_volume": 0.5,
        "audio_start_delay": 0.0,
        "music": "",
        "music_volume": 0.4,
        "music_start_delay": 0.0,
        "subtitle": "Among the tribes were the Affrancians, a peaceful tribe, that worshipped the god of thunder. However, their peaceful ways would soon change."
      },
      {
        "image": "../../Downloads/M1C1I3.png",
        "camera_a": {
          "x": 184.85563909774442,
          "y": 363.2285714285714,
          "width": 1190.3037593984964,
          "height": 669.5458646616543,
          "rotation": 0
        },
        "camera_b": {
          "x": 65.33984962406021,
          "y": 60.587969924812,
          "width": 1398.1834586466164,
          "height": 786.4781954887218,
          "rotation": 0.0
        },
        "pan_duration": 12.0,
        "crossfade_duration": 1.0,
        "easing": "linear",
        "audio": "../../Downloads/M1C1I3V.mp3",
        "audio_volume": 0.5,
        "audio_start_delay": 0.0,
        "music": "",
        "music_volume": 0.4,
        "music_start_delay": 0.0,
        "subtitle": "Using the influence of the Thunder priests, the Chief of the Affrancians spread false threats about the surrounding tribes, urging the local populace to prepare for war."
      },
      {
        "image": "../../Downloads/M1C1I4.png",
        "camera_a": {
          "x": 605.7308270676692,
          "y": 5.0842105263158,
          "width": 921,
          "height": 518,
          "rotation": 0
        },
        "camera_b": {
          "x": 1.1548872180451326,
          "y": 186.57960526315765,
          "width": 1465.9368421052632,
          "height": 824.5894736842106,
          "rotation": 0
        },
        "pan_duration": 13.0,
        "crossfade_duration": 1.0,
        "easing": "linear",
        "audio": "../../Downloads/M1C1I4V.mp3",
        "audio_volume": 0.5,
        "audio_start_delay": 0.0,
        "music": "",
        "music_volume": 0.4,
        "music_start_delay": 0.0,
        "subtitle": "Heeding the call of their priests, the once peaceful Affrancians became pawns in their chief's power hunger. Soon enough, the people became consumed by the new ways."
      },
      {
        "image": "../../Downloads/M1C1I5.png",
        "camera_a": {
          "x": 718.13984962406,
          "y": 97.8529135338344,
          "width": 725.854135338346,
          "height": 408.29295112781966,
          "rotation": 0
        },
        "camera_b": {
          "x": 18.093233082706774,
          "y": 88.51043233082714,
          "width": 1444.378947368421,
          "height": 812.4631578947368,
          "rotation": 0.0
        },
        "pan_duration": 8.0,
        "crossfade_duration": 1.0,
        "easing": "linear",
        "audio": "../../Downloads/M1C1I5V.mp3",
        "audio_volume": 0.5,
        "audio_start_delay": 0.0,
        "music": "",
        "music_volume": 0.4,
        "music_start_delay": 0.0,
        "subtitle": "Soon, bloodshed would consume the once-peaceful valleys of the Euve."
      }
    ]
  },
  "mission_1_outro": {
    "slides": [
      {
        "image": "../../Downloads/M1C2I1.png",
        "camera_a": {
          "x": 438.0015037593985,
